@prefix : <http://andreeaene.ro#> .
@prefix schema: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:flota {
    :Avion1 a schema:Vehicle ;
            schema:name "Boeing 737 YR-BGD" ;
            :model "Boeing 737" ;
            schema:vehicleSeatingCapacity 189 ;
            schema:vehicleModelDate 2005 ;
            schema:brand "TAROM" .

    :Avion2 a schema:Vehicle ;
            schema:name "Airbus A320 YR-LCA" ;
            :model "Airbus A320" ;
            schema:vehicleSeatingCapacity 150 ;
            schema:vehicleModelDate 2010 ;
            schema:brand "Blue Air" .

    :Avion3 a schema:Vehicle ;
            schema:name "Airbus A321 HA-LXA" ;
            :model "Airbus A321" ;
            schema:vehicleSeatingCapacity 230 ;
            schema:vehicleModelDate 2015 ;
            schema:brand "Wizz Air" .
}

:zboruri {
